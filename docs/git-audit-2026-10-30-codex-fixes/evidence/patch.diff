+    QCOMPARE(run({"add", "file.txt"}).exitCode, 0);
+    QVERIFY(put("file.txt", working));
+  }
+  if (deletedDirectory)
+    QVERIFY(QDir(dir.filePath("removed")).removeRecursively());
+
+  const QStringList statusArgs = {"--no-optional-locks", "status",
