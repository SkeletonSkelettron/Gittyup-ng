// Opens the QML forms of src/ui/qml in Qt Design Studio. The forms get their
// data from C++ objects that only exist in the application, like 'dialog' and
// 'detailView', so the designer shows them without it. designer/imports has
// stand-ins for the types of the "Gittyup" module.
import QmlProject

Project {
    mainFile: "src/ui/qml/AboutDialog.qml"

    QmlFiles {
        directory: "src/ui/qml"
    }

    ImageFiles {
        directory: "src/ui/qml/icons"
    }

    importPaths: [ "designer/imports" ]

    qt6Project: true
}
